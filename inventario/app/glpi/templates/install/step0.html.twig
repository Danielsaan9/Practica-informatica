<div class="container text-center">
   <div class="text-start">
       <twig:Alert
           :heading="__('Installation or update of GLPI')"
           :content="__('Choose \'Install\' for a completely new installation of GLPI, or select \'Upgrade\' to update your version of GLPI from an earlier version.')"
       />
   </div>

   <form action="install.php" method="post" class="d-inline" data-submit-once>
      <button type="submit" name="submit" class="btn btn-primary">
         {{ _x("button", "Install") }}
         <i class="fas fa-download ms-1" aria-hidden="true"></i>
      </button>

      <input type="hidden" name="update" value="no">
      <input type="hidden" name="install" value="Etape_0">
   </form>

   <form action="install.php" method="post" class="d-inline" data-submit-once>
      <button type="submit" name="submit" class="btn btn-primary">
         {{ _x("button", "Upgrade") }}
         <i class="fas fa-caret-square-up ms-1" aria-hidden="true"></i>
      </button>

      <input type="hidden" name="update" value="yes">
      <input type="hidden" name="install" value="Etape_0">
   </form>
</div>
