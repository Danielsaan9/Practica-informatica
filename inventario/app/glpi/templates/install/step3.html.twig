<h3>{{ __('Test of the connection at the database') }}</h3>

{% if host|length == 0 or user|length == 0 or link.connect_error %}

    <twig:Alert:Danger
        :heading="__('Can\'t connect to the database')"
        :content="__('The server answered: %s')|format(link.connect_error)"
    />

   <form action="install.php" method="post" class="d-inline" data-submit-once>
      <button type="submit" name="submit" class="btn btn-warning">
         <i class="ti ti-chevron-left me-1 fs-2x alert-icon" aria-hidden="true"></i>
         {{ __("Back") }}
      </button>

      <input type="hidden" name="update" value="{{ update }}">
      <input type="hidden" name="install" value="Etape_1">
   </form>
{% else %}
    <twig:Alert:Success
        :content="__('Database connection successful')"
    />

   {% if not engine_requirement.isValidated() %}
       <twig:Alert:Danger :heading="__('Database engine is not supported.')">
           <twig:block name="content">
               <ul class="alert-list">
                   {% for message in engine_requirement.getValidationMessages() %}
                       <li>{{ message }}</li>
                   {% endfor %}
               </ul>
           </twig:block>
       </twig:Alert:Danger>
   {% endif %}

   {% if not config_requirement.isValidated() %}
       <twig:Alert:Danger :heading="__('Database configuration is not supported.')">
           <twig:block name="content">
               <ul class="alert-list">
                   {% for message in config_requirement.getValidationMessages() %}
                       <li>{{ message }}</li>
                   {% endfor %}
               </ul>
           </twig:block>
       </twig:Alert:Danger>
   {% endif %}

   {% if engine_requirement.isValidated() and config_requirement.isValidated() %}
      <div class="container mt-4">
         <form action='install.php' method='post'>
            <div class="mb-3">
                {% if update == "no" %}
                    <h3>{{ __('Please select a database:') }}</h3>

                    <div class="hr-text text-white mt-6">
                        {{ __('Create a new database:') }}
                    </div>
                    <input type="text" name="newdatabasename" id="new_db" class="form-control" autofocus>

                    <div class="hr-text text-white mt-6">
                        {{ __('Or use an existing one:') }}
                    </div>
                {% else %}
                    <h3>{{ __('Please select a database to update:') }}</h3>
                {% endif %}

                {% for database in databases %}
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="databasename" id="{{ database|slug }}" value="{{ database }}">
                        <label class="form-check-label" for="{{ database|slug }}">
                            {{ database }}
                        </label>
                    </div>
                {% endfor %}
            </div>

            <button type="submit" name="submit" class="btn btn-primary">
               {{ __("Continue") }}
               <i class="ti ti-chevron-right ms-1" aria-hidden="true"></i>
            </button>

            {% if update == "no" %}
               <input type="hidden" name="install" value="Etape_3">
            {% else %}
               <input type="hidden" name="install" value="update_1">
            {% endif %}
         </form>
      </div>
   {% endif %}
{% endif %}
