{% macro action_link(url, label, icon, btn_class, tooltip) %}
   <li class="nav-item">
      <a href="{{ url }}" class="btn btn-sm {{ btn_class|default('btn-ghost-secondary') }} me-1 pe-2"
         data-bs-toggle="tooltip" data-bs-placement="bottom" title="{{ tooltip|default(label) }}">
         <i class="{{ icon }}" aria-hidden="true"></i>
         <span class="d-none d-xxl-block" aria-hidden="true">{{ label }}</span>
         <span class="visually-hidden">{{ label }}</span>
      </a>
   </li>
{% endmacro %}
{% import _self as context_links %}

{% set links = menu[sector]['content'][item]['options'][option]['links'] ?? menu[sector]['content'][item]['links'] ?? '' %}
{% set lists_itemtype = menu[sector]['content'][item]['options'][option]['lists_itemtype'] ?? menu[sector]['content'][item]['lists_itemtype'] ?? '' %}
{% if lists_itemtype is empty %}
    {% set lists_itemtype = item %}
{% endif %}

{% set display_divider = (links['add'] is defined or links|length > 0) %}

{% if display_divider %}
   {# @TODO  border-start is not implemented in current boostrap beta (remove border-left when done)  #}
   <ul class="nav navbar-nav border-start border-left ps-1 ps-sm-2 flex-row">
{% endif %}

{% if links['add'] is defined %}
   {{ context_links.action_link(path(links['add']), __('Add'), 'ti ti-plus', 'btn-primary') }}
{% endif %}

{% for type, link in links %}
   {% if type == 'add' or type == 'search' or type == 'lists' %}
   {% elseif type == 'template' %}
      {{ context_links.action_link(path(link), __('Templates'), 'ti ti-template', null, __('Manage templates...')) }}
   {% elseif type == 'showall' %}
      {{ context_links.action_link(path(link), __('Show all'), 'ti ti-eye-check') }}
   {% elseif type == 'summary' %}
      {{ context_links.action_link(path(link), __('Summary'), 'ti ti-notes') }}
   {% elseif type == 'summary_kanban' %}
      {{ context_links.action_link(path(link), __('Global Kanban'), 'ti ti-layout-columns') }}
   {% elseif type == 'transfer_list' %}
      {{ context_links.action_link(path(link), __('Transfer list'), 'ti ti-list-check') }}
   {% elseif type == 'config' %}
      {{ context_links.action_link(path(link), __('Setup'), 'ti ti-tool') }}
   {% elseif type == 'view_form_categories' %}
      {{ context_links.action_link(path(link), 'Glpi\\Form\\Category'|itemtype_name(get_plural_number()), 'ti ti-folder') }}
   {% elseif type == 'all_articles' %}
      {{ context_links.action_link(path(link), __('All articles'), 'ti ti-list-search') }}
   {% elseif type == 'import_forms' %}
      {{ context_links.action_link(path(link), __('Import forms'), 'ti ti-file-arrow-left') }}
   {% elseif type == 'Glpi\\Dropdown\\DropdownDefinition' %}
      {{ context_links.action_link(
         path(link),
         'Glpi\\Dropdown\\DropdownDefinition'|itemtype_name,
         'Glpi\\Dropdown\\DropdownDefinition'|itemtype_icon
      ) }}
   {% else %}
      <li class="nav-item">
         <a href="{{ path(link) }}" class="btn btn-sm btn-ghost-secondary me-1 pe-2">
            {{ type|raw }}
         </a>
      </li>
   {% endif %}

{% endfor %}

{% if display_divider %}
   </ul>
{% endif %}
