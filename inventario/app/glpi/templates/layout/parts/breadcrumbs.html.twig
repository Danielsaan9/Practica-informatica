{% set menu_labels_es = {'Assets': 'Activos', 'Dashboard': 'Tablero', 'Computers': 'Computadores', 'Monitors': 'Monitores', 'Network devices': 'Dispositivos de red', 'Peripherals': 'Periféricos', 'Printers': 'Impresoras', 'Phones': 'Teléfonos', 'Simcards items': 'Tarjetas SIM', 'Global': 'Todos los activos', 'Assistance': 'Asistencia', 'Management': 'Gestión', 'Administration': 'Administración', 'Setup': 'Configuración'} %}
<nav aria-label="{{ __('Breadcrumbs') }}">
   <ol class="breadcrumb breadcrumb-alternate pe-1 pe-sm-3">
      <li class="breadcrumb-item text-truncate">
      <a href="{{ index_path() }}" class="d-inline-flex align-items-center gap-1">
            <i class="ti ti-home-2" aria-hidden="true"></i>
            {{ __('Home') }}
         </a>
      </li>

      {% if menu[sector] is defined %}
      <li class="breadcrumb-item text-truncate">
      <a href="{{ path(menu[sector]['default'] ?? '/front/central.php') }}" class="d-inline-flex align-items-center gap-1">
            {% if menu[sector]['icon'] is defined and menu[sector]['icon'] is not empty %}
                <i class="{{ menu[sector]['icon'] }}" aria-hidden="true"></i>
            {% endif %}
            {{ menu_labels_es[menu[sector]['title']] ?? menu[sector]['title'] }}
         </a>
      </li>
      {% endif %}

      {% set with_option = false %}
      {% if menu[sector]['content'][item] is defined %}
         {% if menu[sector]['content'][item]['page'] is defined %}
         {% set with_option = option is not empty and menu[sector]['content'][item]['options'][option]['title'] is defined and menu[sector]['content'][item]['options'][option]['page'] is defined %}
         <li class="breadcrumb-item text-truncate">
            <a href="{{ path(menu[sector]['content'][item]['page']) }}"
               class="d-inline-flex align-items-center gap-1"
               {% if not with_option %}aria-current="page"{% endif %}>
               {% if menu[sector]['content'][item]['icon'] is defined and menu[sector]['content'][item]['icon'] is not empty %}
                   <i class="{{ menu[sector]['content'][item]['icon'] }}" aria-hidden="true"></i>
               {% endif %}
               {{ menu_labels_es[menu[sector]['content'][item]['title']] ?? menu[sector]['content'][item]['title'] }}
            </a>
         </li>
         {% endif %}

         {% if with_option %}
         <li class="breadcrumb-item text-truncate">
            <a href="{{ path(menu[sector]['content'][item]['options'][option]['page']) }}"
               class="d-inline-flex align-items-center gap-1"
               aria-current="page"
               data-bs-toggle="tooltip" data-bs-placement="bottom"
               title="{{ menu[sector]['content'][item]['options'][option]['title'] }}" >
               {% if menu[sector]['content'][item]['options'][option]['icon'] is defined and menu[sector]['content'][item]['options'][option]['icon'] is not empty %}
                   <i class="{{ menu[sector]['content'][item]['options'][option]['icon'] }}" aria-hidden="true"></i>
               {% endif %}
               {{ menu[sector]['content'][item]['options'][option]['title']|u.truncate(17, '...') }}
            </a>
         </li>
         {% endif %}

      {% endif %}
   </ol>
</nav>

{% if menu[sector]['content'][item] is defined %}
    {{ include('layout/parts/context_links.html.twig') }}
{% endif %}
