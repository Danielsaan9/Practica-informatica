{# Recursive macro to render nested POST arrays as hidden inputs #}
{% macro render_inputs(data, prefix) %}
    {% for key, value in data %}
        {% set field_name = prefix ? prefix ~ '[' ~ key ~ ']' : key %}
        {% if value is iterable %}
            {{ _self.render_inputs(value, field_name) }}
        {% else %}
            <input type="hidden" name="{{ field_name }}" value="{{ value }}">
        {% endif %}
    {% endfor %}
{% endmacro %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ __('Redirecting...') }}</title>
</head>
<body>
    <form method="{{ http_method }}" action="{{ url }}" id="redirect-form" data-submit-once>
        {{ _self.render_inputs(replay_data, '') }}
    </form>
    <script>document.getElementById('redirect-form').submit();</script>
    <noscript>
        <button form="redirect-form" type="submit">{{ __('Continue') }}</button>
    </noscript>
</body>
</html>

