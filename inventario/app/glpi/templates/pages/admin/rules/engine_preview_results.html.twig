<div class="card">
   <div class="card-header">
      <h3 class="card-title">{{ __('Result details') }}</h3>
   </div>
   <div class="card-body">
      <table class="table">
         <tbody>
            {% for result in results %}
               <tr>
                  <td>{{ result['name'] }}</td>
                  <td>{{ result['result'] }}</td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
      <table class="table mt-4">
         <thead>
            <tr>
               <th colspan="2" class="center">
                  <h4>
                     <span>{{ __('Rule results') }}</span>
                     <br>
                     <span class="text-{{ global_result_raw ? 'success' : 'danger' }}">
                        {{ _n('Validation', 'Validations', 1) }}: {{ global_result }}
                     </span>
                  </h4>
               </th>
            </tr>
         </thead>
         <tbody>
            {% for result_action in result_actions %}
               <tr>
                  <td>{{ result_action['name'] }}</td>
                  <td>{{ result_action['value'] }}</td>
               </tr>
            {% endfor %}
         </tbody>
      </table>
   </div>
</div>
