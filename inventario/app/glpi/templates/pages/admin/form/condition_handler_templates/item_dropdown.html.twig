{% import 'components/form/fields_macros.html.twig' as fields %}

<input
    type="hidden"
    name="{{ input_name }}[itemtype]"
    value="{{ itemtype }}"
    data-glpi-conditions-editor-value
>

{% if input_value is iterable and input_value.itemtype is not same as(itemtype) %}
    {% set input_value = {
        'itemtype': itemtype,
        'items_ids': [0],
    } %}
{% endif %}

{# Ensure that items_ids is always an array, even for single selection #}
{% if input_value is iterable and input_value.items_ids is not iterable %}
    {% set input_value = input_value|merge({'items_ids': [input_value.items_ids]}) %}
{% endif %}

{{ fields.dropdownField(
    itemtype,
    input_name ~ '[items_ids]',
    is_multiple_items ? input_value.items_ids|default([]) : input_value.items_ids|default([0])|first,
    '',
    {
        'no_label'     : true,
        'wrapper_class': '',
        'mb'           : '',
        'aria_label'   : input_label,
        'addicon'      : false,
        'comments'     : '',
        'specific_tags': {
            'data-glpi-conditions-editor-value': '',
        },
        'field_class'  : [
            'me-2 value-selector flex-grow-1',
        ]|join(' '),
        'multiple'     : is_multiple_items,
    }
) }}
