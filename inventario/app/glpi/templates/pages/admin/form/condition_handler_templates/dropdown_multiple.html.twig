{% set input_value = input_value ?? [] %}
{% set input_value = input_value is iterable ? input_value : [input_value] %}

<span class="me-2 value-selector flex-grow-1">
    {% do call('Dropdown::showFromArray', [
        input_name,
        values|default([]),
        {
            'values': input_value,
            'aria_label': input_label,
            'add_data_attributes': {
                'glpi-conditions-editor-value': '',
            },
            'multiple': true,
        }
    ]) %}
</span>
