<button
    type="button"
    class="btn btn-link"
    data-bs-toggle="modal"
    data-bs-target="#form-translation-modal-{{ form_translation.fields['language'] }}"
    aria-label="{{ __('Edit translation') }}"
>
    <strong>{{ call('Dropdown::getLanguageName', [form_translation.fields['language']]) }}</strong>
</button>

<div class="modal fade" id="form-translation-modal-{{ form_translation.fields['language'] }}" tabindex="-1" role="dialog" aria-labelledby="form-translation-modal-title-{{ form_translation.fields['language'] }}">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <form class="modal-content" method="POST"
            data-ajax-submit
            data-ajax-submit-url="{{ path('Form/Translation/' ~ form.getID() ~ '/' ~ form_translation.fields['language']) }}"
        >
            <input type="hidden" name="form_translation_id" value="{{ form_translation.getID() }}" />

            <div class="modal-header border-bottom-0">
                <h5 class="modal-title" id="form-translation-modal-title-{{ form_translation.fields['language'] }}">
                    {{ __('Form translations: %s')|format(call('Dropdown::getLanguageName', [form_translation.fields['language']])) }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
            </div>
            <div
                class="modal-body p-0"
                data-glpi-form-translation-content-url="{{ path('Form/Translation/' ~ form.getID() ~ '/' ~ form_translation.fields['language']) }}"
            >
                <div class="d-flex justify-content-center p-4">
                    <div class="spinner-border text-secondary" role="status">
                        <span class="visually-hidden">{{ __('Loading...') }}</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                {% if can_update %}
                    <div class="d-flex flex-row-reverse w-100" role="group" aria-label="{{ __('Form actions') }}">
                        <button
                            class="btn btn-primary ms-2"
                            name="update"
                            type="submit"
                            aria-label="{{ __('Save translation') }}"
                            disabled
                        >
                            <i class="ti ti-device-floppy me-2" aria-hidden="true"></i>
                            {{ __("Save") }}
                        </button>
                        <button
                            class="btn btn-ghost-danger"
                            name="delete"
                            type="submit"
                            form="form-translation-delete-{{ form_translation.fields['language'] }}"
                            aria-label="{{ __('Delete translation') }}"
                        >
                            <i class="ti ti-trash me-2" aria-hidden="true"></i>
                            {{ __("Delete") }}
                        </button>
                    </div>
                {% else %}
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x me-2" aria-hidden="true"></i>
                        {{ __("Close") }}
                    </button>
                {% endif %}
            </div>
        </form>
        {% if can_update %}
            <form
                id="form-translation-delete-{{ form_translation.fields['language'] }}"
                method="POST"
                action="{{ path('Form/Translation/' ~ form.getID() ~ '/' ~ form_translation.fields['language'] ~ '/Delete') }}"
                hidden
            >
                <input type="hidden" name="form_translation_id" value="{{ form_translation.getID() }}" />
            </form>
        {% endif %}
    </div>
</div>

<script>
    $(function() {
        // Translation rows are loaded on demand to avoid rendering every language of the form at once
        $('#form-translation-modal-{{ form_translation.fields['language']|e('js') }}').one('show.bs.modal', (event) => {
            const body = $(event.currentTarget).find('[data-glpi-form-translation-content-url]');
            $.get(body.data('glpiFormTranslationContentUrl'))
                .done((html) => {
                    body.html(html);
                    // Saving before rows are loaded would submit an empty translation set
                    $(event.currentTarget).find('button[name="update"]').prop('disabled', false);
                })
                .fail(() => {
                    body.html('<div class="alert alert-danger m-3" role="alert">{{ __('An unexpected error occurred')|e('js') }}</div>');
                });
        });
    });
</script>
