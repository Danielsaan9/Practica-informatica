{% set display = false %}
{% if value_type == "specific" %}
   {% set out = call([item, "getValueToSelect"], [searchopt, inputname, value, options2]) %}
   {% if out is not empty %}
      {% set display = true %}
      {{ out|raw }}
   {% endif %}
   {% if not display and plug is not null %}
      {% set display = call_plugin_one_hook(plug['plugin'], 'searchOptionsValues', {
         name: inputname,
         searchtype: searchtype,
         searchoption: searchopt,
         value: value,
      }) %}
   {% endif %}
{% elseif value_type == "empty" %}
   <input type="hidden" name="{{ inputname }}" value="null">
{% endif %}

{% if not display %}
   <input type="text" class="form-control" size="13" aria-label="{{ __('Criteria value') }}" name="{{ inputname }}" value="{{ value }}">
{% endif %}
