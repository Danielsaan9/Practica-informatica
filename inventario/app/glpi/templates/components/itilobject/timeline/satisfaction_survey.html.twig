{% if survey is defined and survey %}
<form
    data-testid="survey"
    class="mt-5 w-100 hide-form-button-separator"
    method="POST"
    action="{{ get_class(survey)|itemtype_form_path }}"
>
    <div>
        {{ survey.showSatisfactionForm(item, false) }}
        {# showSatisfactionForm closes the extra div and form tag by itself... #}
{% endif %}
