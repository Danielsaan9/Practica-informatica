{% import 'components/form/fields_macros.html.twig' as fields %}

{% set urgency_options = field_options|merge({
   'disabled': (not (canupdate or can_requester))
}) %}
{% if field_options.fields_template.isMandatoryField('urgency') %}
   {% set urgency_options = urgency_options|merge({
      'required': true,
   }) %}
{% endif %}
{% if field_options.fields_template.isReadonlyField('urgency') %}
   {% set urgency_options = urgency_options|merge({
      'readonly': true,
   }) %}
{% endif %}

{{ fields.field(
   'urgency',
   item.dropdownUrgency({
      'value': item.fields['urgency'],
      'width': '100%',
      'display': false,
      'rand': field_options.rand,
   }|merge(urgency_options)),
   __('Urgency'),
   field_options|merge({
      'id': 'dropdown_urgency' ~ field_options.rand,
   })
) }}

{% set impact_options = field_options %}
{% if field_options.fields_template.isMandatoryField('impact') %}
   {% set impact_options = impact_options|merge({
      'required': true,
   }) %}
{% endif %}
{% if field_options.fields_template.isReadonlyField('impact') %}
   {% set impact_options = impact_options|merge({
      'readonly': true,
   }) %}
{% endif %}

{{ fields.field(
   'impact',
   item.dropdownImpact({
      'value': item.fields['impact'],
      'width': '100%',
      'display': false,
      'rand': field_options.rand,
   }|merge(impact_options)),
   __('Impact'),
   field_options|merge({
      'id': 'dropdown_impact' ~ field_options.rand,
   })
) }}

{% set priority_options = field_options|merge({
   'disabled': (not canpriority),
   'withmajor': true
}) %}
{% if field_options.fields_template.isMandatoryField('priority') %}
   {% set priority_options = priority_options|merge({
      'required': true,
   }) %}
{% endif %}
{% if field_options.fields_template.isReadonlyField('priority') %}
   {% set priority_options = priority_options|merge({
      'readonly': true,
   }) %}
{% endif %}

{{ fields.field(
   'priority',
   item.dropdownPriority({
      'value': item.fields['priority'],
      'width': '100%',
      'display': false,
      'rand': field_options.rand,
   }|merge(field_options|merge(priority_options))),
   __('Priority'),
   field_options|merge({
      'id': 'dropdown_priority' ~ field_options.rand,
   })
) }}

<script type="text/javascript">
$(function() {
   $('#dropdown_urgency{{ field_options.rand }}, #dropdown_impact{{ field_options.rand }}').on('change.select2', function (e) {
      $.ajax({
         url: `${CFG_GLPI.root_doc}/ajax/priority.php`,
         datatype: 'json',
         data: {
            'urgency': $('#dropdown_urgency{{ field_options.rand }}').select2('data') ? $('#dropdown_urgency{{ field_options.rand }}').select2('data')[0].id : 0,
            'impact':  $('#dropdown_impact{{ field_options.rand }}').select2('data') ? $('#dropdown_impact{{ field_options.rand }}').select2('data')[0].id : 0,
            '_predefined_fields':  $('input[name="_predefined_fields"]').val(),
            'getJson': true,
         }
      }).done(function(data) {
         $('#dropdown_priority{{ field_options.rand }}').val(data.priority);
         $('#dropdown_priority{{ field_options.rand }}').trigger('change');
      });
   })
});
</script>
