{% if canedit %}
    {% include 'components/tab/addlink_block.html.twig' with {'add_link': form_url, 'button_label': __('Add a remote management')} %}
{% endif %}

{% if entries|length > 0 %}
    {{ include('components/datatable.html.twig', {
        'is_tab': true,
        'nofilter': true,
        'nosort': true,
        'columns': {
            'remoteid': __('Remote ID'),
            'type': _n('Type', 'Types', 1),
            'comment': __('Comments'),
        },
        'formatters': {
            'remoteid': 'raw_html',
        },
        'entries': entries,
        'total_number': entries|length,
        'showmassiveactions': canedit,
        'massiveactionparams': massiveactionparams,
    }, with_context = false) }}
{% else %}
    <twig:Alert
        :content="__('No results found')"
    />
{% endif %}

